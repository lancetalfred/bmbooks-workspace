{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Docusaurus",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/bookkeeper_docs"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting the development server",
          "endsPattern": "Docusaurus website is running at"
        }
      },
      "group": "build"
    }
  ]
}
