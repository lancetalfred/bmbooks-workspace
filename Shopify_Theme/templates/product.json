                    "custom_liquid": "{% if product.description != blank %}\n  {% assign desc_stripped = product.description | strip_html %}\n  {% assign word_count = desc_stripped | split: ' ' | size %}\n  {% assign word_limit = 35 %}\n\n  <div class=\"bmb-desc\" id=\"bmb-desc-{{ product.id }}\">\n    {% if word_count > word_limit %}\n      <p class=\"bmb-desc__excerpt\">\n        {{ desc_stripped | truncatewords: word_limit, '' }}&hellip; <button class=\"bmb-desc__btn\" onclick=\"document.getElementById('bmb-desc-{{ product.id }}').classList.add('bmb-desc--open')\">Read more</button>\n      </p>\n      <div class=\"bmb-desc__full\">\n        {{ product.description }}\n        <button class=\"bmb-desc__btn bmb-desc__btn--less\" onclick=\"document.getElementById('bmb-desc-{{ product.id }}').classList.remove('bmb-desc--open')\">Read less</button>\n      </div>\n    {% else %}\n      <div style=\"display:block\">{{ product.description }}</div>\n    {% endif %}\n  </div>\n{% endif %}\n\n<style>\n  .bmb-desc { margin-bottom: 16px; max-width: 70ch; }\n  .bmb-desc__full { display: none; }\n  .bmb-desc--open .bmb-desc__excerpt { display: none; }\n  .bmb-desc--open .bmb-desc__full { display: block; }\n\n  .bmb-desc__excerpt,\n  .bmb-desc__full {\n    font-size: 0.88rem;\n    line-height: 1.7;\n    color: rgba(0,0,0,0.812);\n    margin: 0;\n  }\n\n  .bmb-desc__btn {\n    background: none;\n    border: none;\n    padding: 0;\n    color: #1A0A2E;\n    font-size: 0.82rem;\n    font-weight: 600;\n    cursor: pointer;\n    text-decoration: underline;\n    font-family: inherit;\n  }\n  .bmb-desc__btn:hover { color: #5C0670; }\n  .bmb-desc__btn--less { display: block; margin-top: 12px; }\n</style>"
