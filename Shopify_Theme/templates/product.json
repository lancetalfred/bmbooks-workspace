                  "settings": {
                    "custom_liquid": "{% assign variant = product.selected_or_first_available_variant %}\n\n{% if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 %}\n  {% assign bmb_status = 'instock' %}\n{% else %}\n  {% assign bmb_status = 'available' %}\n{% endif %}\n\n<style>\n  .bmb-avail {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 10px 14px;\n    border-radius: 8px;\n    border: 1px solid;\n    margin-bottom: 12px;\n    max-width: 70ch;\n  }\n  .bmb-avail--instock  { border-color: #B8DFC4; background: #F4FAF6; }\n  .bmb-avail--available { border-color: #E8D46A; background: #FEFDF0; }\n\n  .bmb-avail__badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    padding: 4px 10px;\n    border-radius: 4px;\n    font-weight: 700;\n    font-size: 0.72rem;\n    white-space: nowrap;\n    letter-spacing: 0.01em;\n    flex-shrink: 0;\n  }\n  .bmb-avail--instock  .bmb-avail__badge { background: #D5EFE0; color: #1A5C38; }\n  .bmb-avail--available .bmb-avail__badge { background: #FFF3B0; color: #5C4200; }\n\n  .bmb-avail__shipping {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex: 1;\n  }\n  .bmb-avail__shipping svg {\n    width: 16px;\n    height: 16px;\n    flex-shrink: 0;\n    opacity: 0.65;\n  }\n  .bmb-avail__text {\n    font-size: 0.78rem;\n    color: rgba(0,0,0,0.7);\n    line-height: 1.4;\n  }\n</style>\n\n{% if bmb_status == 'instock' %}\n  <div class=\"bmb-avail bmb-avail--instock\">\n    <div class=\"bmb-avail__badge\">\n      <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <polyline points=\"20 6 9 17 4 12\"/>\n      </svg>\n      In Stock\n    </div>\n    <div class=\"bmb-avail__shipping\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\" rx=\"1\"/>\n        <path d=\"M16 8h4l3 5v4h-7V8z\"/>\n        <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/>\n        <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/>\n      </svg>\n      <div class=\"bmb-avail__text\">In stock · NZ delivery 2–5 working days</div>\n    </div>\n  </div>\n\n{% else %}\n  <div class=\"bmb-avail bmb-avail--available\">\n    <div class=\"bmb-avail__badge\">\n      <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <polyline points=\"20 6 9 17 4 12\"/>\n      </svg>\n      Available\n    </div>\n    <div class=\"bmb-avail__shipping\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n        <polyline points=\"12 6 12 12 16 14\"/>\n      </svg>\n      <div class=\"bmb-avail__text\">We can order this for you – ETA to be advised</div>\n    </div>\n  </div>\n{% endif %}"
