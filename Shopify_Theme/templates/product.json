            "custom_liquid_nyteyA": {
              "type": "custom-liquid",
              "name": "Book Details",
              "settings": {
                "custom_liquid": "{% assign variant = product.variants.first %}\n{% assign isbn = product.metafields.bookscan.isbn %}\n{% assign author = product.metafields.bookscan.author %}\n{% assign pub_date = product.metafields.bookscan.publication_date %}\n{% assign pages = product.metafields.bookscan.pages %}\n{% assign height = product.metafields.bookscan.length %}\n{% assign width = product.metafields.bookscan.width %}\n\n<div class=\"book-details\">\n  <h3 class=\"book-details__heading\">Book Details</h3>\n  <table class=\"book-details__table\">\n    {% if isbn != blank %}\n    <tr><th>ISBN</th><td>{{ isbn }}</td></tr>\n    {% endif %}\n    {% if author != blank %}\n    <tr><th>Author</th><td>{{ author }}</td></tr>\n    {% endif %}\n    {% unless product.vendor == 'Bruce McKenzie Booksellers' or product.vendor == blank %}\n    <tr><th>Publisher</th><td>{{ product.vendor }}</td></tr>\n    {% endunless %}\n    {% if product.type != blank %}\n    <tr><th>Format</th><td>{{ product.type }}</td></tr>\n    {% endif %}\n    {% if pub_date != blank %}\n    <tr><th>Date Published</th><td>{{ pub_date }}</td></tr>\n    {% endif %}\n    {% if height != blank %}\n    <tr><th>Height</th><td>{{ height }}</td></tr>\n    {% endif %}\n    {% if width != blank %}\n    <tr><th>Width</th><td>{{ width }}</td></tr>\n    {% endif %}\n    {% if variant.weight > 0 %}\n    <tr><th>Weight</th><td>{{ variant.weight }}{{ variant.weight_unit }}</td></tr>\n    {% endif %}\n    {% if pages != blank and pages != '0' %}\n    <tr><th>Pages</th><td>{{ pages }}</td></tr>\n    {% endif %}\n  </table>\n</div>\n\n<style>\n.book-details { margin-top: 2rem; border-top: 1px solid rgba(0,0,0,0.06); padding-top: 1.5rem; }\n.book-details__heading { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; color: #000000; }\n.book-details__table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }\n.book-details__table th, .book-details__table td { padding: 0.4rem 0; text-align: left; border-bottom: 1px solid rgba(0,0,0,0.06); vertical-align: top; }\n.book-details__table th { width: 40%; color: rgba(0,0,0,0.55); font-weight: 600; }\n.book-details__table td { color: rgba(0,0,0,0.812); }\n</style>"
